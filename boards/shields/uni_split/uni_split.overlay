// uni-split: 5x3+3 split keyboard driven by a single Pro Micro nRF52840.
// Both halves are wired into one 10 column x 4 row matrix.

#include <dt-bindings/zmk/matrix_transform.h>

#include "uni_split-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
        zephyr,display = &oled;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        // Columns 1-10. Columns 1-5 are the left half, 6-10 the right half.
        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH> // col 1  - P0.31
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // col 2  - P0.29
            , <&gpio0 2 GPIO_ACTIVE_HIGH>  // col 3  - P0.02
            , <&gpio1 15 GPIO_ACTIVE_HIGH> // col 4  - P1.15
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // col 5  - P1.13
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // col 6  - P1.11
            , <&gpio0 10 GPIO_ACTIVE_HIGH> // col 7  - P0.10
            , <&gpio0 9 GPIO_ACTIVE_HIGH>  // col 8  - P0.09
            , <&gpio1 6 GPIO_ACTIVE_HIGH>  // col 9  - P1.06
            , <&gpio1 4 GPIO_ACTIVE_HIGH>  // col 10 - P1.04
            ;

        // Rows 1-4, top to bottom.
        row-gpios
            = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 1 - P0.17
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 2 - P0.20
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 3 - P0.22
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // row 4 - P0.24
            ;
    };

    default_transform: default_transform {
        // Matrix positions (pins are numbered row 1-4 and column 1-10):
        //   row 1: C1 C2 C3 C4 C5 | C6 C7 C8 C9 C10
        //   row 2: C1 C2 C3 C4 C5 | C6 C7 C8 C9 C10
        //   row 3: C1 C2 C3 C4 C5 | C6 C7 C8 C9 C10
        //   row 4:       C3 C4 C5 | C6 C7 C8
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
        >;
    };
};

// The nice!nano default I2C0 pins (D2/D3, P0.17/P0.20) are matrix rows 1 and
// 2 on this keyboard, so move I2C0 to D0/D1 (P0.08/P0.06) for the OLED.
//
// SDA is wired to D0 (P0.08), SCL to D1 (P0.06).
&pinctrl {
    i2c0_oled_default: i2c0_oled_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 8)>,
                    <NRF_PSEL(TWIM_SCL, 0, 6)>;
            bias-pull-up;
        };
    };

    i2c0_oled_sleep: i2c0_oled_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 8)>,
                    <NRF_PSEL(TWIM_SCL, 0, 6)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

// Same shape ZMK's own OLED shields (Corne, Kyria, Waterfowl) ship with.
&pro_micro_i2c {
    status = "okay";
    pinctrl-0 = <&i2c0_oled_default>;
    pinctrl-1 = <&i2c0_oled_sleep>;
    pinctrl-names = "default", "sleep";

    // 128x64 SSD1306 OLED at the usual 0x3c address.
    // `segment-remap` + `com-invdir` rotate the image 180 degrees.
    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
};
