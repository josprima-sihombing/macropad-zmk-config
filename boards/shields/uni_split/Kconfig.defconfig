if SHIELD_UNI_SPLIT

config ZMK_KEYBOARD_NAME
    default "uni-split"

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

# A mono 128x64 OLED needs LVGL in 1-bit mode, otherwise ZMK does not
# initialise the monochrome theme and nothing is drawn on the panel.
if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # SHIELD_UNI_SPLIT
