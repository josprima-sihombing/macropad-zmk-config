#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Dummy bindings: key 1 -> A, key 2 -> B, ... key 11 -> K.
            bindings = <
                &kp A &kp B &kp C &kp D
                &kp E &kp F &kp G &kp H
                &kp I &kp J &kp K
            >;
        };
    };
};
