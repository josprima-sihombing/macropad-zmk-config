#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Hold key 1 for layer 1.
            // Keys 2-11 type 1, 2, 3, 4, 5, 6, 7, 8, 9, 0.
            bindings = <
                &mo 1 &kp N1 &kp N2 &kp N3 &kp N4
                &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
            >;
        };

        layer_1 {
            // Hold key 1, then press key 11 to unlock ZMK Studio.
            // Everything else falls through to layer 0.
            bindings = <
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &studio_unlock
            >;
        };
    };
};
